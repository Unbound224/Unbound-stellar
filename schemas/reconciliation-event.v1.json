{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceRepo": {
      "type": "string",
      "const": "unbound-stellar"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "network": {
      "type": "string",
      "const": "TESTNET"
    },
    "ledgerCursor": {
      "type": "string",
      "minLength": 1
    },
    "entityRef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "transaction"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "ref"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "FAILED",
        "RECONCILING"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "ledger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "amountOutActual": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{7}$"
    }
  },
  "required": [
    "id",
    "sourceRepo",
    "schemaVersion",
    "network",
    "ledgerCursor",
    "entityRef",
    "status",
    "observedAt"
  ],
  "additionalProperties": false
}
